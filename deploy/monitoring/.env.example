# Copy thành .env trong /opt/monitoring — KHÔNG commit file .env thật.
# docker compose đọc file này để nội suy vào docker-compose.monitoring.yml.

# Grafana admin (dùng mật khẩu mạnh — Grafana expose ra internet qua subdomain)
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=
GF_ROOT_URL=https://grafana.hangil.io.vn

# Telegram alert — token từ @BotFather, chat id từ https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
